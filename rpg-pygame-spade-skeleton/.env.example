# Copy to .env and fill in. NEVER commit .env.

# --- Option A: one account for everything -----------------------------------
# All agents connect as USER@XMPP_SERVER with distinct XMPP resources
# (player, world, enemy, shop). Works with most servers that allow
# multiple resources per account.
XMPP_USER=rpg
XMPP_SERVER=your.jabber.server
XMPP_PASSWORD=secret

# --- Option B: separate accounts (preferred) --------------------------------
# Uncomment and SPADE will use one JID per agent instead of resources.
# Every account must exist on the server.
# XMPP_PLAYER=player@your.jabber.server
# XMPP_PLAYER_PASSWORD=secret
# XMPP_WORLD=world@your.jabber.server
# XMPP_WORLD_PASSWORD=secret
# XMPP_ENEMY=enemy@your.jabber.server
# XMPP_ENEMY_PASSWORD=secret
# XMPP_SHOP=shop@your.jabber.server
# XMPP_SHOP_PASSWORD=secret
